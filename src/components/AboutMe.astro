---
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const t = CONTENT[Astro.props.lang].about
---

<div class="mt-10 max-w-3xl space-y-5 text-lg leading-relaxed [&_strong]:font-medium [&_strong]:text-ink">
  {t.paragraphs.map((paragraph, i) => <p class="reveal" style={`--reveal-delay: ${i * 80}ms`} set:html={paragraph} />)}
</div>

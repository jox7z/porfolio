---
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import CvButton from "@/components/CvButton.astro"
import { CONTENT, LINKS, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = CONTENT[lang]
---

<section id="inicio" class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-32 md:px-8 md:pt-40 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
  <div>
    <div class="reveal flex flex-wrap items-center gap-4">
      <img
        class="size-14 rounded-full object-cover ring-1 ring-line ring-offset-4 ring-offset-bg"
        src="/cara.jpg"
        alt="Jose Hernández"
        width="56"
        height="56"
      />
      <span class="inline-flex items-center gap-2 rounded-sm border border-accent2/30 bg-accent2/10 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-accent2">
        <span class="relative flex size-1.5">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent2 opacity-70 motion-reduce:animate-none"></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-accent2"></span>
        </span>
        {t.hero.status}
      </span>
    </div>

    <p class="reveal mt-8 font-mono text-sm text-muted" style="--reveal-delay: 60ms">
      <span class="text-accent">&gt;</span>
      {t.hero.greeting}
    </p>
    <h1 class="reveal mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl" style="--reveal-delay: 120ms">
      {t.hero.role}<span class="cursor text-accent">_</span>
    </h1>

    <p class="reveal mt-6 max-w-lg text-lg leading-relaxed" style="--reveal-delay: 180ms">{t.hero.intro}</p>

    <div class="reveal mt-8" style="--reveal-delay: 240ms">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">{t.hero.openTo}:</p>
      <ul class="mt-3 space-y-1.5 font-mono text-sm">
        {
          t.hero.roles.map((role) => (
            <li class="flex items-center gap-3 text-ink">
              <span class="text-accent" aria-hidden="true">→</span>
              {role}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 flex items-center gap-3 font-mono text-xs text-muted">
        <span class="text-accent2" aria-hidden="true">●</span>
        {t.hero.learning}
      </p>
    </div>

    <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay: 300ms">
      <a href={LINKS.mailCompose} target="_blank" rel="noopener noreferrer" class="btn-primary group">
        <MailIcon class="size-4" />
        {t.hero.ctaPrimary}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <GitHubIcon class="size-4" /> GitHub
      </a>
      <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <LinkedInIcon class="size-4" /> LinkedIn
      </a>
      <CvButton lang={lang} />
    </div>
  </div>

  <!-- Terminal que se escribe sola -->
  <div class="reveal" style="--reveal-delay: 360ms">
    <div class="overflow-hidden rounded-md border border-line bg-surface/80 shadow-2xl shadow-black/20">
      <div class="flex items-center gap-2 border-b border-line px-4 py-3">
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="size-2.5 rounded-full bg-accent"></span>
        <span class="ml-3 font-mono text-xs text-muted">jose@costa-rica: ~</span>
      </div>
      <div id="terminal" class="min-h-[16rem] space-y-4 p-5 font-mono text-[13px] leading-relaxed">
        {
          t.hero.terminal.map(({ command, output, live }) => (
            <div class="term-line" data-command={command}>
              <p>
                <span class="text-accent2">~</span>
                <span class="text-muted"> $ </span>
                <span class="term-cmd text-ink">{command}</span>
              </p>
              <p class="term-out text-body">
                {live ? <span class="cr-clock">San José, CR</span> : output}
              </p>
            </div>
          ))
        }
        <p aria-hidden="true">
          <span class="text-accent2">~</span>
          <span class="text-muted"> $ </span>
          <span class="inline-block h-4 w-2 translate-y-0.5 animate-pulse bg-accent motion-reduce:animate-none"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<a
  href="#sobre-mi"
  class="reveal mx-auto flex max-w-6xl items-center gap-2 px-5 font-mono text-xs text-muted transition-colors hover:text-accent md:px-8"
  style="--reveal-delay: 420ms"
>
  <span class="inline-block animate-bounce motion-reduce:animate-none" aria-hidden="true">↓</span>
  {t.hero.scroll}
</a>

<style>
  .btn-primary {
    @apply inline-flex items-center gap-2 rounded-sm bg-accent px-5 py-2.5 text-sm font-semibold text-[#0a0b0c] transition hover:-translate-y-0.5;
  }

  .btn-ghost {
    @apply inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2.5 text-sm font-medium text-ink transition hover:-translate-y-0.5 hover:border-accent/60;
  }

  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>

<script>
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  document.addEventListener("astro:page-load", async () => {
    // Hora real de Costa Rica para el comando `date`
    const clocks = document.querySelectorAll<HTMLElement>(".cr-clock")
    const format = new Intl.DateTimeFormat(document.documentElement.lang === "es" ? "es-CR" : "en-US", {
      weekday: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "America/Costa_Rica",
    })
    const tick = () => clocks.forEach((clock) => (clock.textContent = `${format.format(new Date())} · San José, CR (GMT-6)`))
    tick()
    const id = window.setInterval(tick, 15_000)
    document.addEventListener("astro:before-swap", () => window.clearInterval(id), { once: true })

    const terminal = document.getElementById("terminal")
    if (!terminal || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    const lines = Array.from(terminal.querySelectorAll<HTMLElement>(".term-line"))
    // El texto completo queda en el HTML para lectores de pantalla y SEO; aquí solo se anima
    lines.forEach((line) => {
      line.style.visibility = "hidden"
      const cmd = line.querySelector<HTMLElement>(".term-cmd")
      if (cmd) cmd.textContent = ""
      line.querySelector<HTMLElement>(".term-out")?.classList.add("opacity-0")
    })

    await sleep(600)
    for (const line of lines) {
      if (!line.isConnected) return
      const cmd = line.querySelector<HTMLElement>(".term-cmd")
      const out = line.querySelector<HTMLElement>(".term-out")
      line.style.visibility = "visible"
      for (const char of line.dataset.command ?? "") {
        if (cmd) cmd.textContent += char
        await sleep(42)
      }
      await sleep(200)
      out?.classList.remove("opacity-0")
      await sleep(350)
    }
  })
</script>

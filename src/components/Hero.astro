---
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import CvButton from "@/components/CvButton.astro"
import HeroNetwork from "@/components/HeroNetwork.astro"
import { CONTENT, LINKS, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = CONTENT[lang]
---

<div class="relative isolate">
<HeroNetwork />
<section id="inicio" class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-32 md:px-8 md:pt-40 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
  <div id="hero-copy" class="will-change-transform">
    <p class="reveal font-mono text-sm text-muted">
      <span class="text-accent">&gt;</span>
      <span data-scramble>{t.hero.greeting}</span>
    </p>
    <!-- Cada letra sube con un pequeño retraso; el texto completo queda en aria-label -->
    <h1 class="reveal kinetic mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl" aria-label={t.hero.role}>
      {
        t.hero.role.split(" ").map((word, w, words) => (
          <>
            {w > 0 && " "}
            <span class="inline-block whitespace-nowrap" aria-hidden="true">
              {[...word].map((char, c) => (
                <span class="kinetic-char" style={`--i: ${words.slice(0, w).join("").length + c}`}>
                  {char}
                </span>
              ))}{w === words.length - 1 && <span class="cursor text-accent">_</span>}
            </span>
          </>
        ))
      }
    </h1>

    <p class="reveal mt-6 max-w-lg text-lg leading-relaxed" style="--reveal-delay: 180ms">{t.hero.intro}</p>

    <div class="reveal mt-8" style="--reveal-delay: 240ms">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">{t.hero.openTo}:</p>
      <ul class="mt-3 space-y-1.5 font-mono text-sm">
        {
          t.hero.roles.map((role) => (
            <li class="flex items-center gap-3 text-ink">
              <span class="text-accent" aria-hidden="true">→</span>
              {role}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 flex items-center gap-3 font-mono text-xs text-muted">
        <span class="text-accent2" aria-hidden="true">●</span>
        {t.hero.learning}
      </p>
    </div>

    <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay: 300ms">
      <a href={LINKS.mailCompose} target="_blank" rel="noopener noreferrer" class="btn-primary group" data-magnetic>
        <MailIcon class="size-4" />
        {t.hero.ctaPrimary}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <GitHubIcon class="size-4" /> GitHub
      </a>
      <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">
        <LinkedInIcon class="size-4" /> LinkedIn
      </a>
      <CvButton lang={lang} />
    </div>
  </div>

  <!-- Terminal que se escribe sola y luego sigue "trabajando" con comandos en bucle -->
  <div class="reveal" style="--reveal-delay: 360ms">
    <div id="hero-term" class="will-change-transform">
      <div class="term-frame rounded-md p-px shadow-2xl shadow-black/30" data-tilt>
        <div class="overflow-hidden rounded-[calc(0.375rem-1px)] bg-surface">
          <div class="flex items-center gap-2 border-b border-line px-4 py-3">
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-accent"></span>
            <span class="ml-3 font-mono text-xs text-muted">jose@costa-rica: ~</span>
          </div>
          <div id="terminal" class="min-h-[16rem] space-y-4 p-5 font-mono text-[13px] leading-relaxed">
            {
              t.hero.terminal.map(({ command, output, live }) => (
                <div class="term-line" data-command={command}>
                  <p>
                    <span class="text-accent2">~</span>
                    <span class="text-muted"> $ </span>
                    <span class="term-cmd text-ink">{command}</span>
                  </p>
                  <p class="term-out text-body">
                    {live ? <span class="cr-clock">San José, CR</span> : output}
                  </p>
                </div>
              ))
            }
            <div aria-hidden="true">
              <p>
                <span class="text-accent2">~</span>
                <span class="text-muted"> $ </span>
                <span id="term-live-cmd" class="text-ink"></span>
                <span class="caret inline-block h-4 w-2 translate-y-0.5 bg-accent"></span>
              </p>
              <!-- Reserva una línea para que la terminal no cambie de alto -->
              <p id="term-live-out" class="min-h-[1.625em] text-accent2"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</div>


<style>
  .btn-primary {
    @apply inline-flex items-center gap-2 rounded-sm bg-accent px-5 py-2.5 text-sm font-semibold text-[#0a0b0c] transition hover:-translate-y-0.5;
  }

  .btn-ghost {
    @apply inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2.5 text-sm font-medium text-ink transition hover:-translate-y-0.5 hover:border-accent/60;
  }

  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .kinetic-char {
    display: inline-block;
    animation-play-state: paused;
    animation: char-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(200ms + var(--i) * 28ms);
  }

  .kinetic.is-visible .kinetic-char {
    animation-play-state: running;
  }

  @keyframes char-rise {
    from {
      opacity: 0;
      transform: translateY(0.45em) rotateX(70deg);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .caret {
    animation: blink 1s steps(1) infinite;
  }

  /* Borde de la terminal: una luz naranja-turquesa que recorre el contorno */
  @property --term-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .term-frame {
    background: conic-gradient(
      from var(--term-angle),
      rgb(var(--c-line)) 0deg,
      rgb(var(--c-accent) / 0.9) 50deg,
      rgb(var(--c-accent2) / 0.9) 100deg,
      rgb(var(--c-line)) 150deg,
      rgb(var(--c-line)) 360deg
    );
    animation: term-spin 6s linear infinite;
  }

  @keyframes term-spin {
    to {
      --term-angle: 360deg;
    }
  }

  /* Movimiento desactivado con el botón Motion */
  :global(html.motion-off) .cursor,
  :global(html.motion-off) .caret,
  :global(html.motion-off) .kinetic-char,
  :global(html.motion-off) .term-frame {
    animation: none;
  }

  :global(html.motion-off) .term-frame {
    background: rgb(var(--c-line));
  }
</style>

<script>
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  // Comandos del día a día en soporte y desarrollo que la terminal repite en bucle
  const LIVE: [command: string, output: string][] = [
    ["ping -n 1 google.com", "Reply from 142.250.64.78: time=14ms"],
    ["ipconfig /flushdns", "Successfully flushed the DNS Resolver Cache."],
    ["sfc /scannow", "No integrity violations found."],
    ["git push origin main", "→ deployed to Cloudflare Pages"],
    ["ticket close #1042", "✓ resolved · documented"],
  ]

  // Parallax del hero: el texto sube y la terminal baja, rota y crece levemente mientras sales del inicio
  document.addEventListener("astro:page-load", () => {
    const copy = document.getElementById("hero-copy")
    const term = document.getElementById("hero-term")
    if (!copy || !term || document.documentElement.classList.contains("motion-off")) return

    const controller = new AbortController()
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })

    let frame = 0
    const update = () => {
      frame = 0
      const desktop = window.innerWidth >= 1024
      // Avance desde que el hero toca el borde superior de la pantalla
      const top = copy.parentElement?.getBoundingClientRect().top ?? 0
      const p = Math.min(1, Math.max(0, -top / (window.innerHeight * 0.9)))
      copy.style.transform = `translateY(${-p * (desktop ? 28 : 8)}px)`
      term.style.transform = desktop
        ? `translateY(${p * 55}px) rotate(${p * 4}deg) scale(${1 + p * 0.035})`
        : `translateY(${p * 12}px) rotate(${p}deg)`
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    update()
    window.addEventListener("scroll", schedule, { passive: true, signal: controller.signal })
    window.addEventListener("resize", schedule, { signal: controller.signal })
  })

  document.addEventListener("astro:page-load", async () => {
    // Hora real de Costa Rica para el comando `date`
    const clocks = document.querySelectorAll<HTMLElement>(".cr-clock")
    const format = new Intl.DateTimeFormat(document.documentElement.lang === "es" ? "es-CR" : "en-US", {
      weekday: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "America/Costa_Rica",
    })
    const tick = () => clocks.forEach((clock) => (clock.textContent = `${format.format(new Date())} · San José, CR (GMT-6)`))
    tick()
    const id = window.setInterval(tick, 15_000)
    document.addEventListener("astro:before-swap", () => window.clearInterval(id), { once: true })

    const terminal = document.getElementById("terminal")
    if (!terminal || document.documentElement.classList.contains("motion-off")) return

    const lines = Array.from(terminal.querySelectorAll<HTMLElement>(".term-line"))
    // El texto completo queda en el HTML para lectores de pantalla y SEO; aquí solo se anima
    lines.forEach((line) => {
      line.style.visibility = "hidden"
      const cmd = line.querySelector<HTMLElement>(".term-cmd")
      if (cmd) cmd.textContent = ""
      line.querySelector<HTMLElement>(".term-out")?.classList.add("opacity-0")
    })

    // Si está la pantalla de arranque, la terminal empieza a escribir cuando termina
    if (document.documentElement.classList.contains("intro")) {
      await new Promise((resolve) => document.addEventListener("intro:done", resolve, { once: true }))
    }
    await sleep(600)
    for (const line of lines) {
      if (!line.isConnected) return
      const cmd = line.querySelector<HTMLElement>(".term-cmd")
      const out = line.querySelector<HTMLElement>(".term-out")
      line.style.visibility = "visible"
      for (const char of line.dataset.command ?? "") {
        if (cmd) cmd.textContent += char
        await sleep(42)
      }
      await sleep(200)
      out?.classList.remove("opacity-0")
      await sleep(350)
    }

    // Después sigue "trabajando": escribe un comando, muestra el resultado, lo borra y pasa al siguiente
    const liveCmd = document.getElementById("term-live-cmd")
    const liveOut = document.getElementById("term-live-out")
    if (!liveCmd || !liveOut) return
    for (let i = 0; liveCmd.isConnected; i = (i + 1) % LIVE.length) {
      const [command, output] = LIVE[i]
      await sleep(900)
      for (const char of command) {
        liveCmd.textContent += char
        await sleep(55)
      }
      await sleep(350)
      liveOut.textContent = output
      await sleep(2600)
      liveOut.textContent = ""
      while (liveCmd.textContent) {
        liveCmd.textContent = liveCmd.textContent.slice(0, -1)
        await sleep(18)
      }
    }
  })
</script>

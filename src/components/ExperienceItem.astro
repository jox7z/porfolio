---
interface Props {
  kind: string
  date: string
  title: string
  company: string
  points: string[]
  skills: string[]
}

const { kind, date, title, company, points, skills } = Astro.props
---

<article class="group grid gap-4 border-t border-line py-8 md:grid-cols-[11rem_1fr] md:gap-10">
  <div>
    <p class="font-mono text-sm text-ink transition-colors group-hover:text-accent">{date}</p>
    <p class="mt-2 font-mono text-[11px] uppercase tracking-widest text-muted">{kind}</p>
  </div>

  <div>
    <h3 class="text-xl font-semibold text-ink">{title}</h3>
    <p class="text-accent">{company}</p>

    <ul class="mt-4 space-y-2">
      {
        points.map((point) => (
          <li class="flex gap-3 leading-relaxed">
            <span class="mt-[0.7rem] h-0.5 w-3 shrink-0 bg-accent transition-all duration-300 group-hover:w-5" aria-hidden="true" />
            <span>{point}</span>
          </li>
        ))
      }
    </ul>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Skills">
      {skills.map((skill) => <li class="rounded-sm border border-line px-2 py-1 font-mono text-[11px] text-muted">{skill}</li>)}
    </ul>
  </div>
</article>

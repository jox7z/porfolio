---
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const t = CONTENT[Astro.props.lang]
const currentYear = new Date().getFullYear()
---

<footer class="mx-auto max-w-6xl px-5 md:px-8">
  <div class="h-px bg-line" aria-hidden="true"></div>
  <div class="flex flex-wrap items-center justify-between gap-2 py-8 font-mono text-xs text-muted">
    <p>&copy; {currentYear} Jose Hernández · San José, Costa Rica</p>
    <p>{t.footer.built}</p>
  </div>
</footer>

---
import GitHubIcon from "./icons/GitHub.astro"
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { ui, projects } = CONTENT[lang]
---

<ol class="project-list mt-12 border-b border-line">
  {
    projects.items.map((project, i) => (
      <li class="reveal">
        <article class="project surface-glow group grid gap-6 border-t border-line py-10 md:grid-cols-[9rem_1fr] md:gap-10 lg:px-4">
          <div class="flex items-start gap-4 md:block">
            <span class="block font-mono text-sm text-muted transition-colors duration-300 group-hover:text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="md:mt-4">
              <p class="font-mono text-xs text-muted">{project.year}</p>
              <ul class="mt-2 flex flex-wrap gap-1.5 md:flex-col md:items-start" aria-label="Tags">
                {project.tags.map((tag) => (
                  <li class="rounded-sm bg-accent/10 px-2 py-0.5 font-mono text-[11px] text-accent">{tag}</li>
                ))}
              </ul>
              {project.status && (
                <p class="mt-3 inline-flex items-center gap-1.5 font-mono text-[11px] text-accent2">
                  <span class="size-1.5 rounded-full bg-accent2" aria-hidden="true" />
                  {project.status}
                </p>
              )}
            </div>
          </div>

          <div>
            <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <h3 class="text-2xl font-bold text-ink sm:text-3xl">
                {project.title}
                {project.role && <span class="ml-2 align-middle font-mono text-xs font-normal text-muted">· {project.role}</span>}
              </h3>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 font-mono text-xs text-body transition-colors hover:text-accent"
                aria-label={`${ui.viewCode}: ${project.title} (${ui.opensNewTab})`}
              >
                <GitHubIcon class="size-4" />
                {ui.viewCode}
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            </header>

            <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink/90">{project.summary}</p>

            <div class="mt-5 max-w-2xl border-l-2 border-accent2/60 bg-accent2/[0.04] py-3 pl-4 pr-3">
              <p class="font-mono text-[11px] uppercase tracking-widest text-accent2">// {ui.context}</p>
              <p class="mt-1.5 leading-relaxed">{project.context}</p>
            </div>

            <p class="mt-6 font-mono text-[11px] uppercase tracking-widest text-muted">// {ui.howItWorks}</p>
            <ul class="mt-3 max-w-2xl space-y-2 leading-relaxed">
              {project.highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span class="mt-[0.6rem] h-0.5 w-3 shrink-0 bg-accent transition-all duration-300 group-hover:w-5" aria-hidden="true" />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-6 flex flex-wrap gap-2" aria-label={ui.stack}>
              {project.stack.map((tech) => (
                <li class="rounded-sm border border-line px-2 py-1 font-mono text-[11px] text-muted">{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      </li>
    ))
  }
</ol>

<style>
  /* Al recorrer la lista, los demás proyectos pasan a segundo plano */
  @media (hover: hover) and (min-width: 1024px) {
    .project {
      transition: opacity 0.35s ease;
    }

    .project-list:hover .project:not(:hover) {
      opacity: 0.45;
    }
  }
</style>

---
import GitHubIcon from "./icons/GitHub.astro"
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { ui, projects } = CONTENT[lang]
---

<!--
  Tarjetas compactas: a la vista solo el resumen y el stack; el contexto y los
  detalles técnicos quedan dentro de un desplegable para no saturar de texto.
-->
<ol class="mt-12 grid items-start gap-5 md:grid-cols-2">
  {
    projects.items.map((project, i) => (
      <li class="reveal" style={`--reveal-delay: ${(i % 2) * 100}ms`}>
        <article class="project-card group h-full rounded-lg p-px">
          <div class="surface-glow flex h-full flex-col rounded-[calc(0.5rem-1px)] bg-surface p-6">
            <header class="flex items-start justify-between gap-4">
              <div>
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
                  <span class="text-accent">{String(i + 1).padStart(2, "0")}</span>
                  <span>{project.year}</span>
                  {project.status && (
                    <span class="inline-flex items-center gap-1.5 text-accent2">
                      <span class="size-1.5 rounded-full bg-accent2" aria-hidden="true" />
                      {project.status}
                    </span>
                  )}
                </p>
                <h3 class="mt-2 text-2xl font-bold text-ink">
                  {project.title}
                  {project.role && <span class="ml-2 align-middle font-mono text-xs font-normal text-muted">· {project.role}</span>}
                </h3>
              </div>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="grid size-9 shrink-0 place-items-center rounded-sm border border-line text-body transition hover:border-accent/60 hover:text-accent"
                aria-label={`${ui.viewCode}: ${project.title} (${ui.opensNewTab})`}
                title={ui.viewCode}
              >
                <GitHubIcon class="size-4" />
              </a>
            </header>

            <p class="mt-3 min-h-[5.1em] leading-relaxed text-body">{project.summary}</p>

            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={ui.stack}>
              {project.stack.slice(0, 5).map((tech) => (
                <li class="rounded-sm border border-line px-2 py-0.5 font-mono text-xs text-muted">{tech}</li>
              ))}
            </ul>

            <details class="details mt-5 border-t border-line pt-4">
              <summary class="flex cursor-pointer list-none items-center justify-between font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:text-ink">
                {ui.howItWorks}
                <span class="chevron text-accent transition-transform duration-300" aria-hidden="true">+</span>
              </summary>
              <div class="details-body">
                <p class="mt-4 text-sm leading-relaxed text-muted">{project.context}</p>
                <ul class="mt-3 space-y-2 text-sm leading-relaxed">
                  {project.highlights.map((highlight) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.6rem] h-0.5 w-3 shrink-0 bg-accent" aria-hidden="true" />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </div>
        </article>
      </li>
    ))
  }
</ol>

<style>
  /* Borde de luz: un degradado cónico que gira detrás de la tarjeta al pasar el cursor */
  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .project-card {
    background: rgb(var(--c-line));
    transition: background 0.3s ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    background: conic-gradient(
      from var(--angle),
      rgb(var(--c-line)) 0deg,
      rgb(var(--c-accent)) 60deg,
      rgb(var(--c-accent2)) 120deg,
      rgb(var(--c-line)) 180deg,
      rgb(var(--c-line)) 360deg
    );
    animation: spin-border 3s linear infinite;
  }

  @keyframes spin-border {
    to {
      --angle: 360deg;
    }
  }

  .details[open] .chevron {
    transform: rotate(45deg);
  }

  .details summary::-webkit-details-marker {
    display: none;
  }

  .details[open] .details-body {
    animation: open 0.35s ease-out;
  }

  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Movimiento desactivado con el botón Motion */
  :global(html.motion-off) .project-card:hover,
  :global(html.motion-off) .project-card:focus-within {
    animation: none;
  }

  :global(html.motion-off) .details[open] .details-body {
    animation: none;
  }
</style>

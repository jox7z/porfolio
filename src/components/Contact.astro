---
import GitHubIcon from "./icons/GitHub.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"
import MailIcon from "./icons/Mail.astro"
import CvButton from "./CvButton.astro"
import { CONTENT, LINKS, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const t = CONTENT[Astro.props.lang].contact
---

<div class="reveal">
  <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-muted">
    <span class="text-accent">{t.index}.</span>
    {t.label}
    <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  </p>

  <h2 class="mt-5 text-4xl font-bold tracking-tight text-ink sm:text-6xl">
    {t.title}
  </h2>
  <p class="mt-6 max-w-xl text-lg leading-relaxed">{t.text}</p>

  <a
    href={LINKS.mailCompose}
    target="_blank"
    rel="noopener noreferrer"
    class="group mt-10 inline-flex max-w-full items-center gap-3 break-all border-b-2 border-accent pb-2 text-lg font-semibold text-ink transition-colors hover:text-accent sm:gap-4 sm:break-normal sm:text-3xl"
  >
    <MailIcon class="size-6 shrink-0 sm:size-7" />
    {LINKS.email}
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-2">→</span>
  </a>

  <div class="mt-10 flex flex-wrap gap-3">
    <a
      href={LINKS.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2.5 text-sm font-medium text-ink transition hover:-translate-y-0.5 hover:border-accent/60"
    >
      <GitHubIcon class="size-4" /> GitHub
    </a>
    <a
      href={LINKS.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2.5 text-sm font-medium text-ink transition hover:-translate-y-0.5 hover:border-accent/60"
    >
      <LinkedInIcon class="size-4" /> LinkedIn
    </a>
    <a
      href={LINKS.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2.5 text-sm font-medium text-ink transition hover:-translate-y-0.5 hover:border-accent/60"
    >
      <span class="font-mono text-xs text-accent">@</span> joxphysique
    </a>
    <CvButton lang={Astro.props.lang} />
  </div>
</div>

---
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const t = CONTENT[Astro.props.lang].approach
const stepLabel = Astro.props.lang === "es" ? "Paso" : "Step"
---

<!--
  Historia con scroll: en escritorio la sección queda fija mientras bajas y los
  pasos se activan uno por uno con una barra de progreso. En celular, o con el
  movimiento en pausa, se muestran los tres pasos a la vez.
-->
<div id="approach-story" class="approach-story relative">
  <div class="approach-sticky">
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-72 w-[40rem] max-w-full -translate-x-1/2 rounded-full bg-accent2/[0.06] blur-3xl"></div>

    <header class="reveal mx-auto max-w-3xl text-center">
      <span class="inline-block rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-xs font-medium uppercase tracking-widest text-accent">
        {t.index} · {t.label}
      </span>
      <h2 class="mt-6 text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
        {t.title}
        <span class="block bg-gradient-to-r from-accent to-accent2 bg-clip-text text-transparent">{t.highlight}</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed">{t.intro}</p>
    </header>

    <!-- Progreso de la historia: 01 / 03 y una barra que se llena -->
    <div class="story-progress mx-auto mt-10 max-w-md items-center gap-4 font-mono text-xs text-muted" aria-hidden="true">
      <span><span id="story-step" class="text-ink">01</span> / {String(t.steps.length).padStart(2, "0")}</span>
      <span class="h-0.5 flex-1 overflow-hidden bg-line">
        <span id="story-bar" class="block h-full origin-left bg-gradient-to-r from-accent to-accent2" style="transform: scaleX(0)"></span>
      </span>
    </div>

    <ol class="mt-10 grid gap-6 md:grid-cols-3 md:gap-8">
      {
        t.steps.map(({ icon, title, text, detail }, i) => (
          <li class="story-step reveal relative" style={`--reveal-delay: ${i * 120}ms`}>
            <article class="surface-glow group flex h-full flex-col rounded-md border border-line bg-surface/60 p-6 hover:border-accent/40" data-tilt>
              <div class="flex items-center gap-3">
                <span class="step-icon grid size-10 place-items-center rounded-md border border-accent/30 bg-accent/10 text-accent">
                  {icon === "isolate" && (
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="10.5" cy="10.5" r="6.5" />
                      <path d="m20 20-4.5-4.5" />
                      <circle cx="10.5" cy="10.5" r="2" />
                    </svg>
                  )}
                  {icon === "inspect" && (
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="3" width="6" height="5" rx="1" />
                      <rect x="3" y="16" width="6" height="5" rx="1" />
                      <rect x="15" y="16" width="6" height="5" rx="1" />
                      <path d="M12 8v4M6 16v-2h12v2" />
                    </svg>
                  )}
                  {icon === "resolve" && (
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                      <path d="M14 3v5h5" />
                      <path d="m9 14 2 2 4-4" />
                    </svg>
                  )}
                </span>
                <span class="font-mono text-xs uppercase tracking-widest text-muted">{stepLabel} {i + 1}</span>
              </div>

              <h3 class="mt-5 text-xl font-semibold text-ink">{title}</h3>
              <p class="mt-3 flex-1 leading-relaxed">{text}</p>

              <p class="mt-6 rounded-md border border-line bg-bg/80 px-3 py-2.5 font-mono text-xs leading-relaxed text-accent2">
                {detail}
                <span class="cursor ml-1 inline-block h-3.5 w-1.5 translate-y-0.5 bg-accent2" aria-hidden="true" />
              </p>
            </article>

            {i < t.steps.length - 1 && (
              <span class="absolute -right-6 top-1/2 hidden -translate-y-1/2 font-mono text-sm text-accent/60 md:block" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .story-progress {
    display: none;
  }

  /* Solo en escritorio y con movimiento: la sección se alarga y su contenido queda fijo */
  @media (min-width: 1024px) {
    :global(html:not(.motion-off)) .approach-story {
      height: 260vh;
    }

    :global(html:not(.motion-off)) .approach-sticky {
      position: sticky;
      top: 6rem;
    }

    :global(html:not(.motion-off)) .story-progress {
      display: flex;
    }

    :global(html:not(.motion-off)) .story-step article {
      opacity: 0.35;
      transition:
        opacity 0.5s ease,
        border-color 0.5s ease,
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(html:not(.motion-off)) .story-step.is-active article {
      opacity: 1;
      border-color: rgb(var(--c-accent) / 0.6);
      box-shadow: 0 0 40px -12px rgb(var(--c-accent) / 0.45);
    }

    :global(html:not(.motion-off)) .story-step.is-active .step-icon {
      background-color: rgb(var(--c-accent) / 0.25);
    }
  }

  :global(html.motion-off) .cursor {
    animation: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const story = document.getElementById("approach-story")
    const bar = document.getElementById("story-bar")
    const counter = document.getElementById("story-step")
    if (!story || !bar || !counter || document.documentElement.classList.contains("motion-off")) return

    const controller = new AbortController()
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })
    const steps = Array.from(story.querySelectorAll<HTMLElement>(".story-step"))

    let frame = 0
    const update = () => {
      frame = 0
      // Avance dentro del tramo en que la sección está fija
      const rect = story.getBoundingClientRect()
      const scrollable = story.offsetHeight - window.innerHeight
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 1
      const active = Math.min(steps.length - 1, Math.floor(progress * steps.length))

      bar.style.transform = `scaleX(${progress})`
      counter.textContent = String(active + 1).padStart(2, "0")
      steps.forEach((step, i) => step.classList.toggle("is-active", i === active))
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }

    update()
    window.addEventListener("scroll", schedule, { passive: true, signal: controller.signal })
    window.addEventListener("resize", schedule, { signal: controller.signal })
  })
</script>

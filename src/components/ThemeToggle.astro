---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"

interface Props {
  label: string
}

const { label } = Astro.props
---

<button id="theme-toggle" type="button" class="grid size-full place-items-center" aria-label={label} title={label}>
  <SunIcon class="theme-icon-sun size-4" />
  <MoonIcon class="theme-icon-moon size-4" />
</button>

<style>
  .theme-icon-sun,
  .theme-icon-moon {
    grid-area: 1 / 1;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  :global(.dark) .theme-icon-sun,
  :global(html:not(.dark)) .theme-icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark")
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light")
      } catch {}
    })
  })

  // Las transiciones de vista reemplazan <html>: se reaplica el tema guardado
  document.addEventListener("astro:after-swap", () => {
    try {
      if (localStorage.getItem("theme") === "light") document.documentElement.classList.remove("dark")
    } catch {}
  })
</script>

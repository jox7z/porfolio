---
interface Props {
  index: string
  label: string
}

const { index, label } = Astro.props
---

<div class="reveal">
  <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-muted">
    <span class="text-accent">{index}.</span>
    {label}
    <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  </p>
  <h2 class="mt-5 max-w-3xl text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    <slot />
  </h2>
</div>

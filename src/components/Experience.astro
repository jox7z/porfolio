---
import ExperienceItem from "./ExperienceItem.astro"
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const t = CONTENT[Astro.props.lang].experience
---

<!--
  Línea de tiempo: un carril a la izquierda se llena con el scroll y cada etapa
  se enciende cuando el carril la alcanza.
-->
<div id="timeline" class="relative mt-12 md:pl-10">
  <span class="absolute bottom-0 left-[7px] top-0 hidden w-px bg-line md:block" aria-hidden="true"></span>
  <span
    id="timeline-fill"
    class="absolute left-[7px] top-0 hidden h-full w-px origin-top bg-gradient-to-b from-accent to-accent2 md:block"
    style="transform: scaleY(0)"
    aria-hidden="true"></span>

  <ol class="border-b border-line">
    {
      t.items.map((item, i) => (
        <li class="timeline-item reveal relative" style={`--reveal-delay: ${i * 100}ms`}>
          <span
            class="timeline-dot absolute -left-10 top-[2.35rem] hidden size-[15px] rounded-full border-2 border-line bg-bg md:block"
            aria-hidden="true"
          />
          <ExperienceItem {...item} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline-dot {
    transition:
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      background-color 0.4s ease;
  }

  .timeline-item.lit .timeline-dot {
    border-color: rgb(var(--c-accent));
    background-color: rgb(var(--c-accent) / 0.25);
    box-shadow: 0 0 14px rgb(var(--c-accent) / 0.6);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const timeline = document.getElementById("timeline")
    const fill = document.getElementById("timeline-fill")
    if (!timeline || !fill) return

    const controller = new AbortController()
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })
    const items = Array.from(timeline.querySelectorAll<HTMLElement>(".timeline-item"))

    let frame = 0
    const update = () => {
      frame = 0
      // El carril avanza hasta la mitad de la pantalla
      const rect = timeline.getBoundingClientRect()
      const reach = window.innerHeight * 0.55 - rect.top
      const progress = Math.min(1, Math.max(0, reach / rect.height))
      fill.style.transform = `scaleY(${progress})`
      items.forEach((item) => item.classList.toggle("lit", item.offsetTop + 40 <= reach))
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }

    update()
    window.addEventListener("scroll", schedule, { passive: true, signal: controller.signal })
    window.addEventListener("resize", schedule, { signal: controller.signal })
  })
</script>

---
import ExperienceItem from "./ExperienceItem.astro"
import { CONTENT, type Lang } from "@/i18n/content"

interface Props {
  lang: Lang
}

const t = CONTENT[Astro.props.lang].experience
---

<ol class="mt-12 border-b border-line">
  {
    t.items.map((item, i) => (
      <li class="reveal" style={`--reveal-delay: ${i * 100}ms`}>
        <ExperienceItem {...item} />
      </li>
    ))
  }
</ol>

---
import "@fontsource-variable/onest"

import { ViewTransitions } from "astro:transitions"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import ScrollRail from "@/components/ScrollRail.astro"
import IntroBoot from "@/components/IntroBoot.astro"
import { LANG_PATH, type Lang } from "@/i18n/content"

interface Props {
  title: string
  description: string
  lang?: Lang
  showChrome?: boolean
}

const { description, title, lang = "en", showChrome = true } = Astro.props
const site = Astro.site ?? Astro.url
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={new URL(LANG_PATH.es, site)} />
    <link rel="alternate" hreflang="en" href={new URL(LANG_PATH.en, site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar parpadeo
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.classList.remove("dark")
      } catch {}
      // Las animaciones están activas por defecto; el botón Motion las pausa durante la visita
      try {
        if (sessionStorage.getItem("motion") === "off") document.documentElement.classList.add("motion-off")
      } catch {}
    </script>
    {
      showChrome && (
        <script is:inline>
          // Pantalla de arranque: solo en la primera visita de la sesión y con el movimiento activo
          try {
            if (!sessionStorage.getItem("intro-seen") && !document.documentElement.classList.contains("motion-off"))
              document.documentElement.classList.add("intro")
          } catch {}
        </script>
      )
    }
    <ViewTransitions />
  </head>

  <body class="relative min-h-screen bg-bg text-body antialiased selection:bg-accent/30 selection:text-ink">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <!-- Capa fija: la retícula y los resplandores acompañan todo el scroll -->
      <div class="bg-grid absolute inset-0"></div>
      <div class="bg-glow absolute left-1/2 top-[-12rem] h-[34rem] w-[56rem] max-w-[140vw] -translate-x-1/2 rounded-full bg-accent2/[0.08] blur-3xl"></div>
      <div class="absolute -left-48 top-[45vh] h-[28rem] w-[28rem] rounded-full bg-accent/[0.06] blur-3xl"></div>
      <div class="absolute -right-48 bottom-[-10rem] h-[30rem] w-[30rem] rounded-full bg-accent2/[0.05] blur-3xl"></div>
      <div class="bg-vignette absolute inset-0"></div>
    </div>

    {
      showChrome && (
        <>
          <IntroBoot lang={lang} />
          <Header lang={lang} />
          <ScrollRail lang={lang} />
        </>
      )
    }

    <div class={showChrome ? "xl:pl-44" : ""}>
      <slot />
      {showChrome && <Footer lang={lang} />}
    </div>

    <style is:global>
      :root {
        color-scheme: light;
        --c-bg: 246 245 241;
        --c-surface: 255 255 255;
        --c-ink: 20 21 23;
        --c-body: 55 58 63;
        --c-muted: 100 104 110;
        --c-line: 222 220 213;
        --c-accent: 226 70 32;
        --c-accent2: 13 148 136;
      }

      .dark {
        color-scheme: dark;
        --c-bg: 10 11 12;
        --c-surface: 20 21 23;
        --c-ink: 244 243 239;
        --c-body: 206 210 215;
        --c-muted: 152 157 163;
        --c-line: 43 45 48;
        --c-accent: 255 90 53;
        --c-accent2: 51 230 201;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        /* Base de 17px para que el texto largo se lea con comodidad */
        font-size: 106.25%;
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
      }

      body {
        line-height: 1.7;
      }

      /* Retícula en toda la página, tenue para no competir con el texto */
      .bg-grid {
        background-image:
          linear-gradient(to right, rgb(var(--c-line) / 0.3) 1px, transparent 1px),
          linear-gradient(to bottom, rgb(var(--c-line) / 0.3) 1px, transparent 1px);
        background-size: 56px 56px;
      }

      /* Oscurece suavemente los bordes para que la retícula no compita con el contenido */
      .bg-vignette {
        background: radial-gradient(ellipse 90% 80% at 50% 40%, transparent 55%, rgb(var(--c-bg) / 0.85) 100%);
      }

      .bg-glow {
        animation: glow-breathe 9s ease-in-out infinite alternate;
      }

      @keyframes glow-breathe {
        from {
          opacity: 0.7;
        }
        to {
          opacity: 1;
        }
      }

      /* Movimiento desactivado con el botón Motion */
      html.motion-off .bg-glow {
        animation: none;
      }

      /* Motivo de carril de pista (compartido con el Media Kit) */
      .lane {
        height: 2px;
        background: repeating-linear-gradient(90deg, rgb(var(--c-line)) 0 24px, transparent 24px 40px);
      }

      .lane-accent {
        background: repeating-linear-gradient(90deg, rgb(var(--c-accent)) 0 24px, transparent 24px 40px);
      }

      /* Superficie con foco que sigue al cursor */
      .surface-glow {
        --mx: 50%;
        --my: 50%;
        position: relative;
        isolation: isolate;
      }

      .surface-glow::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        opacity: 0;
        transition: opacity 0.4s ease;
        background: radial-gradient(400px circle at var(--mx) var(--my), rgb(var(--c-accent) / 0.08), transparent 70%);
      }

      .surface-glow:hover::before {
        opacity: 1;
      }

      /* Revelado al hacer scroll */
      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }

      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }

      /* Mientras corre la pantalla de arranque no se hace scroll ni empiezan las animaciones del hero */
      html.intro {
        overflow: hidden;
      }

      html.intro .kinetic-char {
        animation-play-state: paused;
      }

      /* Inclinación 3D que sigue al cursor (ver [data-tilt] en el script) */
      [data-tilt] {
        transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
        transition:
          transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          border-color 0.3s ease;
        will-change: transform;
      }

      /* Botón que se acerca un poco al cursor */
      [data-magnetic] {
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Movimiento desactivado con el botón Motion */
      html.motion-off {
        scroll-behavior: auto;
      }

      html.motion-off .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }

      html.motion-off [data-tilt],
      html.motion-off [data-magnetic] {
        transform: none !important;
      }

      html.motion-off .motion-anim {
        animation: none;
      }
    </style>

    <script>
      const GLYPHS = "!<>-_\\/[]{}=+*^?#01"
      const reduceMotion = () => document.documentElement.classList.contains("motion-off")

      // Texto que se "descifra" de izquierda a derecha (solo en textos monoespaciados, sin saltos de línea)
      const scramble = (el: HTMLElement) => {
        const final = el.dataset.final ?? el.textContent ?? ""
        el.dataset.final = final
        if (reduceMotion()) return
        const duration = 700
        const start = performance.now()
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration)
          const shown = Math.floor(progress * final.length)
          el.textContent = [...final]
            .map((char, i) => (i < shown || char === " " ? char : GLYPHS[Math.floor(Math.random() * GLYPHS.length)]))
            .join("")
          if (progress < 1) requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      }

      document.addEventListener("astro:page-load", () => {
        const controller = new AbortController()
        document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              const target = entry.target as HTMLElement
              target.classList.add("is-visible")
              target.querySelectorAll<HTMLElement>("[data-scramble]").forEach(scramble)
              observer.unobserve(target)
            })
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        )
        // Los revelados esperan a que termine la pantalla de arranque, si está activa
        const observeAll = () => document.querySelectorAll(".reveal").forEach((item) => observer.observe(item))
        if (document.documentElement.classList.contains("intro"))
          document.addEventListener("intro:done", observeAll, { once: true, signal: controller.signal })
        else observeAll()
        controller.signal.addEventListener("abort", () => observer.disconnect())

        if (!window.matchMedia("(pointer: fine)").matches || reduceMotion()) return

        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
          card.addEventListener(
            "pointermove",
            (event) => {
              const rect = card.getBoundingClientRect()
              const x = (event.clientX - rect.left) / rect.width - 0.5
              const y = (event.clientY - rect.top) / rect.height - 0.5
              card.style.setProperty("--rx", `${(-y * 6).toFixed(2)}deg`)
              card.style.setProperty("--ry", `${(x * 6).toFixed(2)}deg`)
            },
            { signal: controller.signal }
          )
          card.addEventListener(
            "pointerleave",
            () => {
              card.style.setProperty("--rx", "0deg")
              card.style.setProperty("--ry", "0deg")
            },
            { signal: controller.signal }
          )
        })

        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((button) => {
          button.addEventListener(
            "pointermove",
            (event) => {
              const rect = button.getBoundingClientRect()
              const x = event.clientX - rect.left - rect.width / 2
              const y = event.clientY - rect.top - rect.height / 2
              button.style.transform = `translate(${x * 0.25}px, ${y * 0.35}px)`
            },
            { signal: controller.signal }
          )
          button.addEventListener("pointerleave", () => (button.style.transform = ""), { signal: controller.signal })
        })
        document.querySelectorAll<HTMLElement>(".surface-glow").forEach((card) => {
          card.addEventListener(
            "pointermove",
            (event) => {
              const rect = card.getBoundingClientRect()
              card.style.setProperty("--mx", `${event.clientX - rect.left}px`)
              card.style.setProperty("--my", `${event.clientY - rect.top}px`)
            },
            { signal: controller.signal }
          )
        })
      })
    </script>
  </body>
</html>

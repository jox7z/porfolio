---
import "@fontsource-variable/onest"

import { ViewTransitions } from "astro:transitions"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import ScrollRail from "@/components/ScrollRail.astro"
import { LANG_PATH, type Lang } from "@/i18n/content"

interface Props {
  title: string
  description: string
  lang?: Lang
  showChrome?: boolean
}

const { description, title, lang = "es", showChrome = true } = Astro.props
const site = Astro.site ?? Astro.url
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={new URL(LANG_PATH.es, site)} />
    <link rel="alternate" hreflang="en" href={new URL(LANG_PATH.en, site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar parpadeo
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.classList.remove("dark")
      } catch {}
    </script>
    <ViewTransitions />
  </head>

  <body class="relative min-h-screen bg-bg text-body antialiased selection:bg-accent/30 selection:text-ink">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <!-- Capa fija: la retícula y los resplandores acompañan todo el scroll -->
      <div class="bg-grid absolute inset-0"></div>
      <div class="bg-glow absolute left-1/2 top-[-12rem] h-[34rem] w-[56rem] max-w-[140vw] -translate-x-1/2 rounded-full bg-accent2/[0.08] blur-3xl"></div>
      <div class="absolute -left-48 top-[45vh] h-[28rem] w-[28rem] rounded-full bg-accent/[0.06] blur-3xl"></div>
      <div class="absolute -right-48 bottom-[-10rem] h-[30rem] w-[30rem] rounded-full bg-accent2/[0.05] blur-3xl"></div>
      <div class="bg-vignette absolute inset-0"></div>
    </div>

    {
      showChrome && (
        <>
          <Header lang={lang} />
          <ScrollRail lang={lang} />
        </>
      )
    }

    <div class={showChrome ? "xl:pl-44" : ""}>
      <slot />
      {showChrome && <Footer lang={lang} />}
    </div>

    <style is:global>
      :root {
        color-scheme: light;
        --c-bg: 246 245 241;
        --c-surface: 255 255 255;
        --c-ink: 20 21 23;
        --c-body: 72 75 80;
        --c-muted: 118 122 128;
        --c-line: 222 220 213;
        --c-accent: 226 70 32;
        --c-accent2: 13 148 136;
      }

      .dark {
        color-scheme: dark;
        --c-bg: 10 11 12;
        --c-surface: 20 21 23;
        --c-ink: 244 243 239;
        --c-body: 178 182 188;
        --c-muted: 139 143 148;
        --c-line: 43 45 48;
        --c-accent: 255 90 53;
        --c-accent2: 51 230 201;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
      }

      /* Retícula en toda la página */
      .bg-grid {
        background-image:
          linear-gradient(to right, rgb(var(--c-line) / 0.5) 1px, transparent 1px),
          linear-gradient(to bottom, rgb(var(--c-line) / 0.5) 1px, transparent 1px);
        background-size: 56px 56px;
      }

      /* Oscurece suavemente los bordes para que la retícula no compita con el contenido */
      .bg-vignette {
        background: radial-gradient(ellipse 90% 80% at 50% 40%, transparent 55%, rgb(var(--c-bg) / 0.85) 100%);
      }

      .bg-glow {
        animation: glow-breathe 9s ease-in-out infinite alternate;
      }

      @keyframes glow-breathe {
        from {
          opacity: 0.7;
        }
        to {
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .bg-glow {
          animation: none;
        }
      }

      /* Motivo de carril de pista (compartido con el Media Kit) */
      .lane {
        height: 2px;
        background: repeating-linear-gradient(90deg, rgb(var(--c-line)) 0 24px, transparent 24px 40px);
      }

      .lane-accent {
        background: repeating-linear-gradient(90deg, rgb(var(--c-accent)) 0 24px, transparent 24px 40px);
      }

      /* Superficie con foco que sigue al cursor */
      .surface-glow {
        --mx: 50%;
        --my: 50%;
        position: relative;
        isolation: isolate;
      }

      .surface-glow::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        opacity: 0;
        transition: opacity 0.4s ease;
        background: radial-gradient(400px circle at var(--mx) var(--my), rgb(var(--c-accent) / 0.08), transparent 70%);
      }

      .surface-glow:hover::before {
        opacity: 1;
      }

      /* Revelado al hacer scroll */
      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }

      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>

    <script>
      document.addEventListener("astro:page-load", () => {
        const controller = new AbortController()
        document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add("is-visible")
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        )
        document.querySelectorAll(".reveal").forEach((item) => observer.observe(item))
        controller.signal.addEventListener("abort", () => observer.disconnect())

        if (!window.matchMedia("(pointer: fine)").matches) return
        document.querySelectorAll<HTMLElement>(".surface-glow").forEach((card) => {
          card.addEventListener(
            "pointermove",
            (event) => {
              const rect = card.getBoundingClientRect()
              card.style.setProperty("--mx", `${event.clientX - rect.left}px`)
              card.style.setProperty("--my", `${event.clientY - rect.top}px`)
            },
            { signal: controller.signal }
          )
        })
      })
    </script>
  </body>
</html>
